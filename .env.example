# ==============================================================================
# CYCLONESHIELD ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice: NEVER commit real production API keys, database credentials, 
# or cryptographic secrets to git. In Vercel, inject these via Project Settings > Environment Variables.

# ------------------------------------------------------------------------------
# 1. CORE SERVER-SIDE CREDENTIALS (Confidential - Server/Edge only)
# ------------------------------------------------------------------------------
# Google Gemini Generative AI API Key for physical grounding & situational reasoning
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Gemini Model identifier (gemini-2.5-flash or gemini-2.5-pro)
GEMINI_MODEL="gemini-2.5-flash"

# Session & Audit Signature Secret (min 32 characters for HMAC-SHA256 signing)
SESSION_SECRET="cycloneshield_production_session_signing_secret_min32chars_key!"

# Base64-encoded Google Earth Engine (GEE) Service Account JSON Key (Loaded server-side only)
GEE_SERVICE_ACCOUNT_BASE64=""

# Server Environment & Port (Default: 3000)
NODE_ENV="development"
PORT=3000

# ------------------------------------------------------------------------------
# 2. MANAGED DATA & STORAGE (Neon/Supabase PostGIS, Upstash Redis, Vercel Blob)
# ------------------------------------------------------------------------------
# Pooled PostGIS Database URL (Neon or Supabase)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/cycloneshield?sslmode=require"

# Upstash Redis REST URL for distributed rate-limiting and response caching
REDIS_URL="https://sample-redis.upstash.io"
REDIS_TOKEN=""

# Cloudflare R2 / AWS S3 / Vercel Blob for PMTiles & Cloud-Optimized GeoTIFFs (COGs)
STORAGE_BUCKET_URL="https://pub-sample-r2.dev"

# ------------------------------------------------------------------------------
# 3. PUBLIC CLIENT-SIDE VARIABLES (Prefixed with VITE_ / NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Public Map Tile Service / Style JSON (CartoDB Dark Matter / OSM)
VITE_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"

# Public App Base URL
VITE_APP_URL="http://localhost:3000"
